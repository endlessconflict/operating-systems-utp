19" value="2) SJF no preemptivo — el más corto de los que ya llegaron" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="900" height="24" as="geometry"/></mxCell><mxCell id="c20" value="P1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="298" width="272" height="34" as="geometry"/></mxCell><mxCell id="c21" value="P2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="422" y="298" width="136" height="34" as="geometry"/></mxCell><mxCell id="c22" value="P4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="558" y="298" width="170" height="34" as="geometry"/></mxCell><mxCell id="c23" value="P3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="728" y="298" width="306" height="34" as="geometry"/></mxCell><mxCell id="c24" style="endArrow=block;html=1;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="332" as="sourcePoint"/><mxPoint x="1068" y="332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="0" style="text;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="135" y="334" width="30" height="18" as="geometry"/></mxCell><mxCell id="c26" value="8" style="text;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="407" y="334" width="30" height="18" as="geometry"/></mxCell><mxCell id="c27" value="12" style="text;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="543" y="334" width="30" height="18" as="geometry"/></mxCell><mxCell id="c28" value="17" style="text;html=1;align=center;fontSize=12;" vert