<mxfile><diagram name="Timeline Lab3B"><mxGraphModel dx="1200" dy="900" grid="0" page="1" pageWidth="1100" pageHeight="1000" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Lab 3B · Timeline verificado a mano (NovaTech, 4 reportes)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Carga: P1 (llega 0, ráfaga 8) · P2 (llega 1, ráfaga 4) · P3 (llega 2, ráfaga 9) · P4 (llega 3, ráfaga 5)&lt;br&gt;Espera = inicio − llegada (no preemptivo) · Retorno = fin − llegada · Espera = retorno − ráfaga (RR)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1000" height="40" as="geometry"/></mxCell><mxCell id="c5" value="1) FCFS — orden de llegada" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="900" height="24" as="geometry"/></mxCell><mxCell id="c6" value="P1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="150" y="140" width="272" height="34" as="geometry"/></mxCell><mxCell id="c7" value="P2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="422" y="140" width="136" height="34" as="geometry"/></mxCell><mxCell id="c8" value="P3" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="558" y="140" width="306" height="34" as="geometry"/></mxCell><mxCell id="c9" value="P4" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="864" y="140" width="