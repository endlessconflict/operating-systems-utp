Vagrant.configure("2") do |config|
  # Para usar un archivo .box local descomenta la siguiente línea y especifica la ruta:
  # config.vm.box_url = "file://./ubuntu-bionic.box"
  
  config.vm.box = "ubuntu/bionic64"
  config.vm.hostname = "so-environment"
  config.vm.network "forwarded_port", guest: 8080, host: 8080, host_ip: "127.0.0.1"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "vm-sistemas-operativos"
    vb.memory = "2048"
    vb.cpus = 2
  end

  # Aprovisionamiento con el script compartido
  config.vm.provision "shell", path: "scripts/setup_env.sh"
end
